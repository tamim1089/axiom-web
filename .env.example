# Copy to .env and fill in from https://my.telegram.org → API development tools
VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=

# Canonical origin. Drives canonical tags, Open Graph URLs, sitemap and schema.
VITE_SITE_URL=

# Metadata sync (optional). Requires SUPABASE_URL + SUPABASE_SERVICE_KEY set in Netlify.
VITE_SYNC_ENABLED=false
